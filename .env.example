# Copy this file to .env.local and fill in the values.
# Find them in the Supabase dashboard: Project > Connect, or Settings > API Keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser;
# every request made with it is still restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY - it bypasses Row Level Security.
# Used by the seed script and by the admin "remove student" action.
# Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=

# Only used by `npm run seed` and `npm run check:security` (never by the app).
# Password given to every demo account the seed script creates. Choose your own,
# at least 8 characters. Do not reuse a real password.
SEED_PASSWORD=
